{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "persona-engine/training-example",
  "title": "Persona Engine — Training Example Schema",
  "description": "Schema for a single training example formatted for causal language model fine-tuning.  Each line in the training JSONL should match this.",
  "type": "object",
  "required": ["conversation_id", "text"],
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Source conversation identifier for traceability."
    },
    "text": {
      "type": "string",
      "description": "Fully formatted training text including conversation history and expected response, using the model's chat template."
    },
    "persona_id": {
      "type": "string"
    },
    "split": {
      "type": "string",
      "enum": ["train", "validation", "test"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "num_turns": { "type": "integer" },
        "target_speaker": { "type": "string" },
        "language": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
